# Loxley Roofing and Construction — server rules

# Canonical host: 301-redirect www -> non-www, preserving https, path and query.
# (HTTP->HTTPS is already handled at the Hostinger/CDN edge, so we deliberately
#  do NOT add an %{HTTPS} rule here — behind a CDN that can cause a redirect loop.)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.loxleyconstruction\.com$ [NC]
  RewriteRule ^(.*)$ https://loxleyconstruction.com/$1 [R=301,L]
</IfModule>

# Caching policy. HTML always revalidates so a content update (new footer, new
# copy, etc.) shows up immediately instead of getting stuck in a visitor's
# browser cache. CSS/JS are fingerprinted with ?v=<hash>, so they're safe to
# cache for a year; other media caches for a month.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|mp4|webm|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
